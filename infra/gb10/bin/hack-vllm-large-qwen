#!/usr/bin/env bash
set -euo pipefail

COMPOSE_FILE="${COMPOSE_FILE:-/home/dell/vllm/docker-compose.large-qwen.yml}"
ENDPOINT="${ENDPOINT:-http://127.0.0.1:8000}"
MODEL_QWEN36="Qwen/Qwen3.6-27B-FP8"
MODEL_NEXT="Qwen/Qwen3-Next-80B-A3B-Thinking-FP8"

usage() {
  cat <<'EOF'
Usage: hack-vllm-large-qwen <command>

Commands:
  start qwen36             Start Qwen/Qwen3.6-27B-FP8 on 127.0.0.1:8000
  start qwen-next-thinking Start Qwen/Qwen3-Next-80B-A3B-Thinking-FP8 on 127.0.0.1:8000
  stop                     Stop large-Qwen compose services
  status                   Show vLLM containers and port mapping
  logs [service]           Tail logs for a service/container
  models                   Query /v1/models
  chat [model]             Run a hello-world chat completion
EOF
}

compose() {
  docker compose -f "$COMPOSE_FILE" "$@"
}

wait_ready() {
  local tries="${1:-180}"
  for _ in $(seq 1 "$tries"); do
    if curl -fsS "$ENDPOINT/v1/models" >/tmp/hack-vllm-models.json 2>/tmp/hack-vllm-curl.err; then
      cat /tmp/hack-vllm-models.json
      return 0
    fi
    sleep 5
  done

  cat /tmp/hack-vllm-curl.err 2>/dev/null || true
  return 1
}

stop_4b_verify() {
  if docker ps -a --format '{{.Names}}' | grep -qx 'vllm-qwen3-4b-verify'; then
    docker rm -f vllm-qwen3-4b-verify >/dev/null
  fi
}

start_model() {
  local slug="$1"
  local service profile model

  case "$slug" in
    qwen36)
      service="vllm-qwen3.6-27b-fp8"
      profile="qwen36"
      model="$MODEL_QWEN36"
      ;;
    qwen-next-thinking)
      service="vllm-qwen3-next-80b-a3b-thinking-fp8"
      profile="qwen-next-thinking"
      model="$MODEL_NEXT"
      ;;
    *)
      usage
      exit 2
      ;;
  esac

  stop_4b_verify
  compose down --remove-orphans
  COMPOSE_PROFILES="$profile" compose up -d --force-recreate "$service"
  wait_ready
  printf '\nReady: %s at %s/v1\n' "$model" "$ENDPOINT"
}

cmd="${1:-}"
case "$cmd" in
  start)
    start_model "${2:-}"
    ;;
  stop)
    compose down --remove-orphans
    ;;
  status)
    docker ps --format 'table {{.Names}}\t{{.Image}}\t{{.Status}}\t{{.Ports}}' | grep -E 'vllm|NAMES' || true
    ;;
  logs)
    docker logs --tail 200 "${2:-vllm-qwen3.6-27b-fp8}"
    ;;
  models)
    curl -fsS "$ENDPOINT/v1/models"
    ;;
  chat)
    model="${2:-$MODEL_QWEN36}"
    curl -fsS "$ENDPOINT/v1/chat/completions" \
      -H 'Content-Type: application/json' \
      -d "{\"model\":\"$model\",\"messages\":[{\"role\":\"user\",\"content\":\"Reply with exactly: hello world\"}],\"max_tokens\":32,\"temperature\":0}"
    ;;
  *)
    usage
    exit 2
    ;;
esac

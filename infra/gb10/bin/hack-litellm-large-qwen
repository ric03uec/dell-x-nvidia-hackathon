#!/usr/bin/env bash
set -euo pipefail

COMPOSE_FILE="${COMPOSE_FILE:-/home/dell/vllm/docker-compose.litellm.yml}"
LITELLM_DIR="${LITELLM_DIR:-/home/dell/vllm/litellm}"
ENV_FILE="${ENV_FILE:-/home/dell/vllm/env/litellm.env}"
ENDPOINT="${ENDPOINT:-http://127.0.0.1:4000}"

usage() {
  cat <<'EOF'
Usage: hack-litellm-large-qwen <command> [args]

Commands:
  start qwen36              Start LiteLLM for current Qwen3.6 backend
  start qwen-next-thinking  Select Qwen Next config and restart LiteLLM
  stop                      Stop LiteLLM + postgres
  status                    Show LiteLLM containers
  logs [container]          Show logs; default hack-litellm
  models                    List models through LiteLLM
  chat [model]              Run hello-world chat through LiteLLM
EOF
}

ensure_env() {
  mkdir -p "$(dirname "$ENV_FILE")"

  if [ ! -f "$ENV_FILE" ]; then
    umask 077
    cat > "$ENV_FILE" <<EOF
LITELLM_MASTER_KEY=sk-$(openssl rand -hex 24)
LITELLM_DB_PASSWORD=$(openssl rand -hex 24)
EOF
  fi

  chmod 600 "$ENV_FILE"
}

key() {
  grep '^LITELLM_MASTER_KEY=' "$ENV_FILE" | cut -d= -f2-
}

select_config() {
  local name="$1"
  case "$name" in
    qwen36)
      cp "$LITELLM_DIR/config.qwen36.yaml" "$LITELLM_DIR/config.yaml"
      ;;
    qwen-next-thinking)
      cp "$LITELLM_DIR/config.qwen-next-thinking.yaml" "$LITELLM_DIR/config.yaml"
      ;;
    *)
      echo "unknown model config: $name" >&2
      usage >&2
      exit 1
      ;;
  esac
}

wait_ready() {
  local token
  token="$(key)"

  for _ in $(seq 1 90); do
    if curl -fsS -H "Authorization: Bearer $token" "$ENDPOINT/v1/models" >/dev/null 2>&1; then
      echo "Ready: LiteLLM at $ENDPOINT/v1"
      return 0
    fi
    sleep 5
  done

  echo "LiteLLM did not become ready" >&2
  docker logs --tail 200 hack-litellm >&2 || true
  exit 1
}

start() {
  local name="$1"
  ensure_env
  mkdir -p "$LITELLM_DIR"
  select_config "$name"
  docker compose --env-file "$ENV_FILE" -f "$COMPOSE_FILE" up -d --force-recreate
  wait_ready
}

models() {
  curl -fsS -H "Authorization: Bearer $(key)" "$ENDPOINT/v1/models"
}

chat() {
  local model="${1:-Qwen3.6-27B-FP8}"
  curl -fsS "$ENDPOINT/v1/chat/completions" \
    -H "Authorization: Bearer $(key)" \
    -H 'Content-Type: application/json' \
    -d "{\"model\":\"$model\",\"messages\":[{\"role\":\"user\",\"content\":\"Reply with exactly: hello world\"}],\"max_tokens\":256,\"temperature\":0}"
}

cmd="${1:-}"
case "$cmd" in
  start)
    start "${2:-qwen36}"
    ;;
  stop)
    docker compose --env-file "$ENV_FILE" -f "$COMPOSE_FILE" down --remove-orphans
    ;;
  status)
    docker ps --format 'table {{.Names}}\t{{.Image}}\t{{.Status}}\t{{.Ports}}' | grep -E 'hack-litellm|NAMES' || true
    ;;
  logs)
    docker logs --tail 200 "${2:-hack-litellm}"
    ;;
  models)
    models
    ;;
  chat)
    chat "${2:-Qwen3.6-27B-FP8}"
    ;;
  *)
    usage >&2
    exit 1
    ;;
esac

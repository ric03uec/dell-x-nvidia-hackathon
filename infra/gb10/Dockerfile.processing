# Processing service, live-scoring surface (component 3) — /health-only
# scaffold. Build context is the repo root so this can COPY services/*.
FROM python:3.11-slim
ARG GIT_SHA=unknown
LABEL org.opencontainers.image.revision=$GIT_SHA

COPY services/processing /app
RUN pip install --no-cache-dir /app

CMD ["python3", "-m", "uvicorn", "processing.app:app", "--host", "0.0.0.0", "--port", "8200"]

# services/dashboard — pnpm/TypeScript, deliberately outside the uv workspace
# (the polyglot seam; see the exclude list in the root pyproject.toml). Driven
# via the root justfile's `just s dashboard <verb>`, mirroring `just a <name>
# <verb>` for agents.
#
# These recipes wrap the app's own package.json scripts rather than replacing
# them, so the app keeps its native `pnpm run …` workflow untouched.

set shell := ["bash", "-uc"]

# List available recipes
[group('project')]
default:
    @just --list

# Install dependencies via pnpm
[group('project')]
setup:
    pnpm install --frozen-lockfile

# Start the dev server on the port assigned in docs/ports.md.
# Passed on the command line because vite.config.ts pins host but not port.
[group('project')]
dev port=env("DASHBOARD_PORT", "8300"):
    pnpm run dev -- --port {{ port }}

# Typecheck and lint. Composed from the app's two scripts — it has no single
# `check` script of its own.
[group('project')]
check:
    pnpm run typecheck
    pnpm run lint

# Production build
[group('project')]
build:
    pnpm run build

# Run API client tests and the production build gate
[group('project')]
test:
    pnpm run test

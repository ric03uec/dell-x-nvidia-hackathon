{
  "name": "squidward-console",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=18.0.0"
  },
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "dev": "vite",
    "mock": "python3 mocks/mock_api.py",
    "build": "vite build",
    "start": "vite preview",
    "test": "pnpm run test:mock && pnpm run test:api && pnpm run build",
    "test:api": "node --test src/api/*.test.js",
    "test:mock": "python3 -m unittest discover -s mocks -p 'test_*.py' -v",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "17.0.2",
    "react-dom": "17.0.2"
  },
  "devDependencies": {
    "@types/node": "20.17.10",
    "@types/react": "17.0.83",
    "@types/react-dom": "17.0.26",
    "@vitejs/plugin-react": "4.3.4",
    "eslint": "9.39.4",
    "typescript": "5.7.3",
    "vite": "5.4.21"
  },
  "type": "module"
}

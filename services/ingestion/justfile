# services/ingestion — component 2 home (FastAPI). Scaffold only: schema,
# adapters, and the real API surface land in epic 2. Driven via the root
# justfile's `just s ingestion <verb>`, mirroring `just a <name> <verb>` for
# agents. Port is the one assigned in docs/ports.md (8100).

set shell := ["bash", "-uc"]

# List available recipes
[group('project')]
default:
    @just --list

# Install this project's dependencies into its own venv
[group('project')]
setup:
    uv sync

# Lint, format-check, and typecheck this project
[group('project')]
check:
    uv run ruff check .
    uv run ruff format --check .
    uv run mypy src

# Auto-fix lint and formatting
[group('project')]
fmt:
    uv run ruff check --fix .
    uv run ruff format .

# Run this project's tests
[group('project')]
test:
    uv run pytest

# Run the ingestion API locally on the port assigned in docs/ports.md
[group('project')]
run port=env("INGESTION_PORT", "8100"):
    uv run uvicorn ingestion.app:app --port {{ port }} --reload

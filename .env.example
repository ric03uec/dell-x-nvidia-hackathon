# Environment variables the exfiltration-protection compose stack reads.
#
#   cp .env.example .env
#
# Then replace every placeholder below with a real value for your box. Ports
# and container names are the table of record at docs/ports.md — add a row
# there before adding a variable here. No real secrets belong in this file or
# in .env; .env is gitignored, this file is not.

# --- GB10 host occupants (pre-existing — see docs/ports.md) ----------------
# Squid (3128), vLLM (8000), and LiteLLM (4000) already run on the box. This
# stack does not deploy them; it only needs to reach LiteLLM, the "local
# model gateway" the architecture puts behind the local inference adapter
# (dxnvh-0e6.2). LITELLM_MASTER_KEY mirrors the placeholder already used in
# infra/gb10/env/litellm.env.example — it is generated on the box, never
# committed, and never real here.
LITELLM_BASE_URL=http://127.0.0.1:4000
LITELLM_MASTER_KEY=CHANGEME
# Runtime services use a scoped virtual key, never the admin/master credential.
LITELLM_API_KEY=CHANGEME
LITELLM_MODEL=Qwen3.6-27B-FP8
LITELLM_TIMEOUT=60

# --- Bind-address classes (docs/ports.md#bind-address-classes) -------------
# MGMT_BIND_ADDR: the analyst-facing, management-network interface. Ingestion
# and the dashboard bind here. 192.0.2.10 is a documentation-only RFC 5737
# placeholder — replace with the GB10's real management-network IP once the
# box is on-site. Never leave this as 0.0.0.0 or a routable/public address.
MGMT_BIND_ADDR=192.0.2.10
# PRIVATE_BIND_ADDR: loopback-only, private to the GB10. Processing binds
# here — nothing off-box may reach it.
PRIVATE_BIND_ADDR=127.0.0.1

# --- Ingestion and storage (component 2) — sole SQLite writer --------------
INGESTION_PORT=8100
INGESTION_DB_PATH=/data/exfilguard.db
# Ingestion stays host-local; the dashboard reverse proxy is the browser-facing
# surface and containers use Compose service discovery.
INGESTION_URL=http://127.0.0.1:8100

# --- Infrastructure and sources (component 1) -------------------------------
# Bind-mounted read-only into the collector; see architecture doc §4.3.
SQUID_ACCESS_LOG_PATH=/var/log/squid/access.log

# --- Refinement and processing (component 3) --------------------------------
# Live scoring and the offline batch runner are separate processes/containers
# on purpose (dxnvh-0e6: live scoring must not share a process with the
# offline model or the security agent).
PROCESSING_LIVE_PORT=8200
PROCESSING_OFFLINE_PORT=8201

# --- UX and dashboard (component 4) -----------------------------------------
# dxnvh-332.3's dev server. Distinct from the stock NVIDIA DGX Dashboard on
# 11000 — read this var for the dev-server port rather than hardcoding a
# framework default (Vite's 5173, Next's 3000, etc).
DASHBOARD_PORT=8300
# Vite proxies same-origin /api requests to ingestion during development.
DASHBOARD_API_TARGET=http://127.0.0.1:8100
VITE_ANALYST_ID=local-analyst
